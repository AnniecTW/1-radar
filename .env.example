# Copy to .env and fill in. Never commit .env; share secret values with teammates privately.

# Required
DJANGO_SECRET_KEY=
DATABASE_URL=

# AI search (Cloudflare Workers AI). Without these, search falls back to keywords.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5
# CLOUDFLARE_TIMEOUT=5
# CLOUDFLARE_SEMANTIC_MIN_SIMILARITY=0.58
# Snap-a-Flyer uses the same Cloudflare keys. Optional overrides:
# CLOUDFLARE_VISION_MODEL=@cf/moondream/moondream3.1-9B-A2B
# FLYER_TIMEOUT=25
# FLYER_DAILY_LIMIT=10

# Explore Map tiles (free key at maptiler.com)
MAPTILER_API_KEY=

# Shared image uploads (event covers, organization logos) in Supabase Storage.
# Supabase: Project Settings > Storage > S3 Connection. Without all five, uploads stay in media/ on your computer.
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=

# Optional: real verification and notification emails (otherwise they print in the runserver terminal)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# DEFAULT_FROM_EMAIL=
# Address used for links in notification emails (default http://127.0.0.1:8000)
# SITE_URL=http://127.0.0.1:8001

# Optional: only if GDAL/GEOS are not in the Homebrew default location
# GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib

# Production only (Azure App Service, radar/settings/production.py). Set there, not in your .env.
# On Azure, DATABASE_URL is Supabase's transaction pooler (port 6543), all five SUPABASE_S3_* keys are
# required (or uploads vanish on restart), and GDAL_LIBRARY_PATH / GEOS_LIBRARY_PATH stay unset.
# ALLOWED_HOSTS=radar-demo.azurewebsites.net
# WEBSITES_PORT=8000
# CSRF_TRUSTED_ORIGINS=https://radar-demo.azurewebsites.net
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=3600
# LOG_LEVEL=INFO
