# Copy to .env and fill in. Never commit .env; share secret values with teammates privately.

# Required
DJANGO_SECRET_KEY=
DATABASE_URL=

# Explore Map tiles (free key at maptiler.com)
MAPTILER_API_KEY=

# Shared image uploads (event covers, organization logos) in Supabase Storage.
# Supabase: Project Settings > Storage > S3 Connection. Without all five, uploads stay in media/ on your computer.
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=

# Optional: real verification emails (otherwise they print in the runserver terminal)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# DEFAULT_FROM_EMAIL=

# Optional: only if GDAL/GEOS are not in the Homebrew default location
# GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib
